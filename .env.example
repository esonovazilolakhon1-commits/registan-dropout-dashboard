# copy this to .env and fill in your values
# .env is only needed for running the live pipeline (api_on_process/run_live_pipeline.py)
# the dashboard works without it — it reads from pre-built parquet files

API_KEY=your_api_key_here
ORGANIZATION=your_organization_here
BRANCH=your_branch_id_here
API_TOKEN=your_bearer_token_here
SCHEDULE_DAY=monday
SCHEDULE_TIME=08:00
