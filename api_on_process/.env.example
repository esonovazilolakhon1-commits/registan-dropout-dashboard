# =============================================================
# .env.example — Registan API configuration
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
#
# API: https://backend.edutizim.uz/external-api
# Auth: POST /sign-with-password → Bearer token
# =============================================================

# ── API key (fixed, does not change) ─────────────────────────
API_KEY=dev:07cacc808ee6a6dd9adce3344ff9bf20

# ── Organisation & branch (fixed for Chilonzor) ──────────────
ORGANIZATION=registan
BRANCH=6266d9e35bbdd74734fddadd

# ── Bearer token ──────────────────────────────────────────────
# Paste your current token here.  extract.py uses this directly.
# The token has a ~1-year expiry.  When it expires, either:
#   (a) run  python3 src/pipeline/extract.py  with API_PHONE +
#       API_PASSWORD set below — the script will log in and
#       print the new token for you to paste here, OR
#   (b) log in manually via the app and copy the token from
#       your browser's local storage / network tab.
API_TOKEN=your_bearer_token_here

# ── Login credentials (only needed to refresh an expired token) ─
# The phone number registered to your Registan admin account.
API_PHONE=+998xxxxxxxxx
# Your account password.
API_PASSWORD=your_password_here

# ── Pagination ────────────────────────────────────────────────
# Number of records fetched per request. 200 is safe for all
# collections including large ones (attendances, transactions).
API_PAGE_SIZE=200

# ── Scheduler ─────────────────────────────────────────────────
# Day and time for the weekly automated pipeline run.
SCHEDULE_DAY=monday
SCHEDULE_TIME=08:00
