# copy this to .env and fill in your values
# don't commit .env to git! it's in .gitignore already

# API key for edutizim — ask the admin if you don't have it
API_KEY=your_api_key_here

# organisation and branch IDs — fixed for Registan Chilonzor
ORGANIZATION=your_organization_here
BRANCH=your_branch_id_here

# bearer token — get this by logging into the app and copying from browser
# or run extract.py with your phone+password and it will print the token
# token lasts about a year
API_TOKEN=your_bearer_token_here

# only needed if you want the script to auto-login and get a new token
API_PHONE=+998xxxxxxxxx
API_PASSWORD=your_password_here

# how many records to fetch per page (200 works fine)
API_PAGE_SIZE=200

# when to run the monthly pipeline
SCHEDULE_DAY=monday
SCHEDULE_TIME=08:00
